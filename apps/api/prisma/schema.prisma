// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies    Company[]
  vacancies    Vacancy[]
  applications Application[]
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(200)
  website   String?  @db.VarChar(500)
  industry  String?  @db.VarChar(150)
  country   String?  @db.VarChar(100)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies Vacancy[]

  @@unique([userId, name])
  @@index([userId])
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

model Vacancy {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  companyId   String    @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.Text
  url         String?   @db.VarChar(1000)
  location    String?   @db.VarChar(200)
  workType    WorkType?
  salaryMin   Decimal?  @db.Decimal(12, 2)
  salaryMax   Decimal?  @db.Decimal(12, 2)
  currency    String?   @db.Char(3)
  source      String?   @db.VarChar(100)
  dateFound   DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application?

  @@index([userId])
  @@index([companyId])
  @@index([title])
  @@index([source])
  @@index([workType])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  vacancyId       String            @unique @db.Uuid
  status          ApplicationStatus
  appliedAt       DateTime?
  lastActivityAt  DateTime
  notes           String?           @db.Text
  rejectionReason String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy       Vacancy                    @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  interviews    Interview[]
  statusHistory ApplicationStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([appliedAt])
  @@index([userId, status])
}

enum InterviewType {
  HR
  TECHNICAL
  LIVE_CODING
  HIRING_MANAGER
  FINAL
  OTHER
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

model Interview {
  id            String           @id @default(uuid()) @db.Uuid
  applicationId String           @db.Uuid
  type          InterviewType
  scheduledAt   DateTime
  interviewer   String?          @db.VarChar(200)
  notes         String?          @db.Text
  result        InterviewResult?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([type])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  status        ApplicationStatus
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([changedAt])
  @@index([applicationId, changedAt])
}
